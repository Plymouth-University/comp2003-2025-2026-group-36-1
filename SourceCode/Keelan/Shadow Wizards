function spawnWizard(cb){
  currentElem=ELEMENTS[Math.floor(Math.random()*ELEMENTS.length)];
  document.documentElement.style.setProperty('--wiz-color',currentElem.color);
  document.documentElement.style.setProperty('--wiz-glow',currentElem.glow);
  const fig=document.getElementById('wizard-figure');
  fig.textContent=currentElem.emoji;
  fig.style.setProperty('--wiz-glow',currentElem.glow);
  fig.className='spawning';
  document.getElementById('wiz-name-label').textContent=currentElem.name+' Wizard';
  document.getElementById('wiz-name-label').style.color=currentElem.color;
  document.getElementById('elem-icon').textContent=currentElem.icon;
  document.getElementById('elem-name').textContent=currentElem.name+' Wizard';
  const badge=document.getElementById('element-badge');
  badge.style.borderColor=currentElem.color;badge.style.color=currentElem.color;
  setTimeout(()=>{fig.className='';if(cb)cb();},500);
}

function killWizard(){
  document.getElementById('wizard-figure').className='dying';
  spawnSparks(currentElem.color);
  setTimeout(()=>{
    score++;document.getElementById('score-val').textContent=score;
    qIdx++;
    if(qIdx>=shuffledQs.length){showWin();return;}
    phase='question';answerLocked=false;resetLock();
    document.getElementById('kill-phase').style.display='none';
    document.getElementById('answer-grid').style.display='grid';
    spawnWizard(()=>loadQuestion());
  },700);
}

/* ─── QUESTION ─── */
function loadQuestion(){
  if(qIdx>=shuffledQs.length){showWin();return;}
  currentQ=shuffledQs[qIdx];
  answerLocked=false;resetLock();phase='question';
  const opts=currentQ.opts.map((o,i)=>({text:o,correct:i===currentQ.ans}));
  shuffle(opts);
  const ids=['btn-a','btn-b','btn-c','btn-d'],txts=['ans-a','ans-b','ans-c','ans-d'],cls=['a','b','c','d'];
  ids.forEach((id,i)=>{
    const b=document.getElementById(id);
    b.dataset.correct=opts[i].correct;
    b.className='answer-btn '+cls[i];
    b.style.pointerEvents='auto';
  });
  txts.forEach((id,i)=>{document.getElementById(id).textContent=opts[i].text;});
  document.getElementById('question-text').textContent=currentQ.q;
  document.getElementById('hud-qnum').textContent=`Q ${qIdx+1}`;
  document.getElementById('hud-bar-fill').style.width=((qIdx/shuffledQs.length)*100)+'%';
  document.getElementById('answer-grid').style.display='grid';
  document.getElementById('kill-phase').style.display='none';
}

/* ─── ANSWER ─── */
function selectAnswer(idx){
  if(phase!=='question') return;
  resetLock();
  const btns=['btn-a','btn-b','btn-c','btn-d'].map(id=>document.getElementById(id));
  const chosen=btns[idx];
  const correct=chosen.dataset.correct==='true';
  btns.forEach(b=>b.style.pointerEvents='none');
  if(correct){
    chosen.classList.add('correct-ans');
    btns.forEach(b=>{if(b.dataset.correct==='true')b.classList.add('reveal-correct');else b.classList.add('wrong-ans');});
    setTimeout(()=>{document.getElementById('answer-grid').style.display='none';showKillPhase();},900);
  } else {
    chosen.classList.add('wrong-ans');
    btns.forEach(b=>{if(b.dataset.correct==='true')b.classList.add('reveal-correct');});
    if(gameMode==='tutorial'){
      setTimeout(()=>{
        qIdx++;answerLocked=false;
        if(qIdx>=shuffledQs.length){showWin();return;}
        spawnWizard(()=>loadQuestion());
      },1400);
    } else {
      setTimeout(()=>showGameOver(),1200);
    }
  }
}

/* ─── KILL PHASE ─── */
function showKillPhase(){
  phase='kill';answerLocked=false;resetLock();
  const e=currentElem;
  document.getElementById('kill-title').textContent=`💥 Finish the ${e.name} Wizard!`;
  document.getElementById('kill-desc').textContent=e.desc;
  const gestures=[
    {name:'Rock', icon:'✊',elem:'rock'},{name:'Fire',icon:'🤘',elem:'fire'},
    {name:'Water',icon:'🤙',elem:'water'},{name:'Wind',icon:'🖐️',elem:'air'}
  ];
  const cont=document.getElementById('kill-gestures-display');
  cont.innerHTML='';
  gestures.forEach(g=>{
    const card=document.createElement('div');
    card.className='kill-gest-card'+(g.elem===e.killGesture?' target':'');
    if(g.elem===e.killGesture){
      card.style.borderColor=e.color;card.style.background=`rgba(${hexRgb(e.color)},0.15)`;card.style.color=e.color;
    }
    card.innerHTML=`<div class="kg-icon">${g.icon}</div><div class="kg-name">${g.name}</div>`;
    cont.appendChild(card);
  });
  document.getElementById('kill-bar-fill').style.width='0%';
  document.getElementById('kill-bar-fill').style.background=`linear-gradient(90deg,${e.color},#fff)`;
  document.getElementById('kill-phase').style.display='flex';
}

function hexRgb(h){const r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);return `${r},${g},${b}`;}

/* ─── END SCREENS ─── */
function showGameOver(){
  phase='result';
  const card=document.getElementById('result-card');
  card.className='result-card lose';
  document.getElementById('result-icon').textContent='💀';
  document.getElementById('result-title').textContent='Game Over!';
  document.getElementById('result-score').textContent=score;
  document.getElementById('result-sub').textContent=`You answered incorrectly and the wizard defeated you! You bested ${score} wizard${score!==1?'s':''} before falling. Will you try again?`;
  document.getElementById('result-overlay').classList.add('show');
}

function showWin(){
  phase='result';
  const card=document.getElementById('result-card');
  card.className='result-card win';
  document.getElementById('result-icon').textContent='🏆';
  document.getElementById('result-title').textContent='You Win!';
  document.getElementById('result-score').textContent=score;
  document.getElementById('result-sub').textContent=`Incredible! You defeated all ${score} Shadow Wizards and conquered the arena! You are a true Archmage!`;
  document.getElementById('result-overlay').classList.add('show');
  launchConfetti();
}

function playAgain(){document.getElementById('result-overlay').classList.remove('show');initGame();}
function goMenu(){document.getElementById('result-overlay').classList.remove('show');showScreen('menu-screen');}
function toggleCamPanel(){camPanelOpen=!camPanelOpen;document.getElementById('cam-panel').classList.toggle('hidden-panel',!camPanelOpen);}

/* ─── EFFECTS ─── */
function spawnSparks(color){
  const cx=innerWidth/2,cy=innerHeight/2;
  for(let i=0;i<18;i++){
    const s=document.createElement('div');s.className='spark';
    const size=Math.random()*12+6,angle=Math.random()*Math.PI*2,dist=60+Math.random()*200;
    s.style.cssText=`width:${size}px;height:${size}px;background:${color};left:${cx}px;top:${cy}px;--tx:${Math.cos(angle)*dist}px;--ty:${Math.sin(angle)*dist}px;animation-delay:${Math.random()*0.2}s;box-shadow:0 0 10px ${color};`;
    document.body.appendChild(s);setTimeout(()=>s.remove(),1100);
  }
}

function launchConfetti(){
  const cols=['#f5c842','#ff5722','#29b6f6','#66bb6a','#e91e63','#9c27b0'];
  for(let i=0;i<80;i++){
    setTimeout(()=>{
      const s=document.createElement('div');s.className='spark';
      const size=Math.random()*10+4;
      s.style.cssText=`width:${size}px;height:${size}px;background:${cols[Math.floor(Math.random()*cols.length)]};border-radius:${Math.random()>0.5?'50%':'2px'};left:${Math.random()*innerWidth}px;top:-10px;--tx:${(Math.random()-0.5)*300}px;--ty:${200+Math.random()*500}px;animation-duration:1.8s;`;
      document.body.appendChild(s);setTimeout(()=>s.remove(),1900);
    },i*25);
  }
}

/* ─── UTILS ─── */
function shuffle(a){const arr=[...a];for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];}return arr;}
function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.add('hidden'));document.getElementById(id).classList.remove('hidden');}
</script>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shadow Wizards</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@400;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js" crossorigin="anonymous"></script>
<style>
:root {
  --bg:#0b0c1a; --bg2:#13152b; --panel:#1a1d35; --border:rgba(255,255,255,0.08);
  --text:#e8eaf6; --muted:#8b8fa8; --gold:#f5c842; --gold2:#ffe082;
  --fire:#ff5722; --ice:#29b6f6; --wind:#66bb6a; --rock:#a1887f;
  --ka:#e21b3c; --kb:#1368ce; --kc:#d89e00; --kd:#26890c;
  --radius:14px; --shadow:0 8px 32px rgba(0,0,0,0.5);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{width:100%;height:100%;overflow:hidden;}
body{background:var(--bg);color:var(--text);font-family:'Nunito',sans-serif;user-select:none;}
#bg-canvas{position:fixed;inset:0;z-index:0;pointer-events:none;}
.screen{position:fixed;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;transition:opacity 0.4s,transform 0.4s;}
.screen.hidden{opacity:0;pointer-events:none;transform:scale(0.97);}

/* MENU */
#menu-screen{gap:24px;}
.logo-icon{font-size:5rem;filter:drop-shadow(0 0 24px rgba(245,200,66,0.7));animation:float 3s ease-in-out infinite;display:block;text-align:center;}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.logo-title{font-family:'Cinzel Decorative',cursive;font-size:clamp(2rem,5vw,3.5rem);font-weight:900;background:linear-gradient(135deg,#f5c842,#ff8a50,#f5c842);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:shimmer 3s linear infinite;text-align:center;line-height:1.1;}
@keyframes shimmer{0%{background-position:0%}100%{background-position:200%}}
.logo-sub{font-family:'Cinzel',serif;font-size:0.85rem;letter-spacing:0.3em;color:var(--muted);margin-top:6px;text-align:center;}
.menu-card{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:26px 32px;width:min(480px,100%);display:flex;flex-direction:column;gap:16px;box-shadow:var(--shadow);}
.menu-label{font-family:'Cinzel',serif;font-size:0.7rem;letter-spacing:0.2em;color:var(--muted);text-transform:uppercase;margin-bottom:4px;}
.diff-row{display:flex;gap:8px;flex-wrap:wrap;}
.diff-btn{flex:1;min-width:55px;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Nunito',sans-serif;font-size:0.85rem;font-weight:700;padding:8px 4px;cursor:pointer;transition:all 0.2s;}
.diff-btn:hover{background:rgba(245,200,66,0.1);border-color:var(--gold);}
.diff-btn.active{background:rgba(245,200,66,0.2);border-color:var(--gold);color:var(--gold);}
.mode-row{display:flex;gap:10px;}
.mode-btn{flex:1;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:8px;color:var(--muted);font-family:'Nunito',sans-serif;font-size:0.85rem;font-weight:700;padding:10px 8px;cursor:pointer;transition:all 0.2s;text-align:center;line-height:1.4;}
.mode-btn:hover{border-color:rgba(255,255,255,0.2);color:var(--text);}
.mode-btn.active{background:rgba(99,179,237,0.15);border-color:#63b3ed;color:#63b3ed;}
.toggle-row{display:flex;align-items:center;gap:12px;padding:10px 14px;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:8px;cursor:pointer;}
.toggle-row span{flex:1;font-size:0.9rem;color:var(--muted);}
.toggle-pill{width:44px;height:24px;background:rgba(255,255,255,0.1);border-radius:12px;position:relative;transition:background 0.3s;flex-shrink:0;}
.toggle-pill::after{content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;background:var(--muted);border-radius:50%;transition:all 0.3s;}
.toggle-row.on .toggle-pill{background:rgba(99,179,237,0.4);}
.toggle-row.on .toggle-pill::after{left:23px;background:#63b3ed;}
.start-btn{background:linear-gradient(135deg,#f5c842,#ff8a50);border:none;border-radius:10px;color:#0b0c1a;font-family:'Cinzel',serif;font-size:1.05rem;font-weight:700;letter-spacing:0.1em;padding:14px;cursor:pointer;transition:all 0.2s;box-shadow:0 4px 20px rgba(245,200,66,0.3);}
.start-btn:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(245,200,66,0.5);}

/* LOADING */
#loading-screen{gap:20px;}
.load-icon{font-size:4rem;animation:spin 2s linear infinite;}
@keyframes spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}
.load-title{font-family:'Cinzel',serif;font-size:1.4rem;color:var(--gold);}
.load-msg{color:var(--muted);font-size:0.95rem;min-height:1.5em;}
.load-bar-wrap{width:260px;height:4px;background:rgba(255,255,255,0.1);border-radius:2px;overflow:hidden;}
.load-bar{height:100%;background:linear-gradient(90deg,var(--gold),#ff8a50);width:0%;border-radius:2px;transition:width 0.3s;}

/* GAME SCREEN */
#game-screen{flex-direction:column;justify-content:flex-start;padding:0;gap:0;}
#hud{width:100%;display:flex;align-items:center;justify-content:space-between;padding:10px 20px;background:rgba(11,12,26,0.95);border-bottom:1px solid var(--border);flex-shrink:0;z-index:20;backdrop-filter:blur(8px);}
.hud-left{display:flex;align-items:center;gap:12px;}
.hud-logo{font-family:'Cinzel Decorative',cursive;font-size:0.95rem;color:var(--gold);}
.hud-mode{font-size:0.72rem;color:var(--muted);background:rgba(255,255,255,0.06);padding:3px 10px;border-radius:20px;border:1px solid var(--border);}
.hud-center{display:flex;align-items:center;gap:10px;}
.hud-qnum{font-family:'Cinzel',serif;font-size:0.82rem;color:var(--muted);}
.hud-bar{width:100px;height:6px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden;}
.hud-bar-fill{height:100%;background:linear-gradient(90deg,var(--gold),#ff8a50);border-radius:3px;transition:width 0.4s;}
.hud-right{display:flex;align-items:center;gap:14px;}
.score-wrap{text-align:right;}
.score-label{font-size:0.62rem;letter-spacing:0.15em;color:var(--muted);text-transform:uppercase;}
.score-val{font-family:'Cinzel',serif;font-size:1.5rem;color:var(--gold);line-height:1;}
.cam-toggle-btn{background:rgba(255,255,255,0.06);border:1px solid var(--border);border-radius:8px;color:var(--muted);font-size:0.78rem;font-family:'Nunito',sans-serif;padding:6px 12px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:5px;}
.cam-toggle-btn:hover{border-color:rgba(255,255,255,0.2);color:var(--text);}

#game-area{flex:1;display:flex;width:100%;overflow:hidden;position:relative;}

/* ARENA */
#arena{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:16px 20px;gap:14px;position:relative;overflow:hidden;}

/* CAM PANEL */
#cam-panel{width:290px;flex-shrink:0;display:flex;flex-direction:column;border-left:1px solid var(--border);background:rgba(10,11,22,0.97);transition:width 0.3s,border 0.3s;overflow:hidden;}
#cam-panel.hidden-panel{width:0;border:none;}
#cam-inner{padding:12px;display:flex;flex-direction:column;gap:10px;flex:1;min-width:266px;}
.cam-title{font-family:'Cinzel',serif;font-size:0.72rem;letter-spacing:0.15em;color:var(--muted);text-transform:uppercase;}
#cam-container{position:relative;border-radius:10px;overflow:hidden;border:1px solid var(--border);background:#000;aspect-ratio:4/3;}
#input-video{display:none;}
#output-canvas{width:100%;height:100%;display:block;transform:scaleX(-1);}
.cam-gest-label{font-size:0.72rem;color:var(--muted);}
#cam-gest-val{font-family:'Cinzel',serif;font-size:1rem;color:var(--gold);min-height:1.4em;filter:drop-shadow(0 0 6px rgba(245,200,66,0.4));}
.lock-row{display:flex;align-items:center;gap:8px;}
.lock-label{font-size:0.72rem;color:var(--muted);white-space:nowrap;}
.lock-bar{flex:1;height:5px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden;}
#lock-bar-fill{height:100%;background:linear-gradient(90deg,#63b3ed,var(--gold));width:0%;border-radius:3px;transition:width 0.05s;}
.gg-title{font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:0.12em;color:var(--muted);text-transform:uppercase;}
.gg-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px;}
.gg-item{background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:6px;padding:6px 8px;display:flex;align-items:center;gap:6px;font-size:0.78rem;}
.gg-icon{font-size:1.1rem;}
.gg-text{color:var(--muted);line-height:1.3;}

/* SPEECH BUBBLE */
#speech-bubble{position:relative;background:rgba(255,255,255,0.96);color:#1a1a2e;border-radius:16px;padding:14px 18px;max-width:min(520px,90%);text-align:center;font-size:clamp(0.85rem,1.8vw,1rem);font-weight:700;line-height:1.4;box-shadow:0 4px 20px rgba(0,0,0,0.5);margin-bottom:4px;order:-1;}
#speech-bubble::after{content:'';position:absolute;bottom:-13px;left:50%;transform:translateX(-50%);border:8px solid transparent;border-top-color:rgba(255,255,255,0.96);border-bottom:none;}
.wiz-name-label{font-family:'Cinzel',serif;font-size:0.68rem;letter-spacing:0.12em;color:#555;margin-bottom:3px;text-transform:uppercase;}

/* WIZARD */
#wizard-wrap{display:flex;flex-direction:column;align-items:center;}
#wizard-figure{font-size:clamp(4rem,8vw,7rem);filter:drop-shadow(0 0 28px var(--wiz-glow,rgba(255,255,255,0.3)));animation:wiz-float 2.5s ease-in-out infinite;transition:filter 0.5s;}
@keyframes wiz-float{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-14px) rotate(2deg)}}
#wizard-figure.dying{animation:wiz-die 0.6s ease-in forwards;}
@keyframes wiz-die{0%{transform:scale(1) rotate(0);opacity:1;filter:brightness(3)}50%{transform:scale(1.3) rotate(10deg);opacity:0.7}100%{transform:scale(0) rotate(30deg);opacity:0}}
#wizard-figure.spawning{animation:wiz-spawn 0.5s ease-out forwards;}
@keyframes wiz-spawn{0%{transform:scale(0) rotate(-20deg);opacity:0}100%{transform:scale(1) rotate(0);opacity:1}}
#element-badge{display:flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-family:'Cinzel',serif;font-size:0.72rem;letter-spacing:0.1em;border:2px solid var(--wiz-color,#999);background:rgba(0,0,0,0.3);color:var(--wiz-color,#999);margin-top:4px;}

/* TUTORIAL BANNER */
.tutorial-banner{background:rgba(99,179,237,0.1);border:1px solid rgba(99,179,237,0.3);border-radius:8px;padding:7px 14px;font-size:0.8rem;color:#63b3ed;text-align:center;width:100%;max-width:580px;}

/* ANSWER GRID */
#answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%;max-width:620px;}
.answer-btn{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:var(--radius);border:2px solid transparent;cursor:pointer;position:relative;overflow:hidden;transition:transform 0.15s,box-shadow 0.15s;text-align:left;}
.answer-btn:hover{transform:translateY(-2px);}
.answer-btn.a{background:rgba(226,27,60,0.85);}
.answer-btn.b{background:rgba(19,104,206,0.85);}
.answer-btn.c{background:rgba(216,158,0,0.85);}
.answer-btn.d{background:rgba(38,137,12,0.85);}
.ans-gesture{background:rgba(0,0,0,0.3);border-radius:8px;padding:7px 9px;font-size:1.5rem;flex-shrink:0;display:flex;flex-direction:column;align-items:center;}
.ans-gesture-lbl{font-size:0.5rem;color:rgba(255,255,255,0.55);margin-top:1px;font-family:'Cinzel',serif;letter-spacing:0.05em;}
.ans-text{font-size:0.9rem;font-weight:700;color:#fff;line-height:1.3;}
.ans-letter{position:absolute;top:7px;right:9px;font-family:'Cinzel',serif;font-size:0.68rem;color:rgba(255,255,255,0.35);}
.answer-btn.correct-ans{border-color:#fff;box-shadow:0 0 0 3px rgba(255,255,255,0.25);animation:flash-correct 0.4s;}
.answer-btn.wrong-ans{border-color:#ff4444;opacity:0.45;}
.answer-btn.reveal-correct{border-color:#00ff88;box-shadow:0 0 0 3px rgba(0,255,136,0.25);}
@keyframes flash-correct{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}

/* KILL PHASE */
#kill-phase{width:100%;max-width:560px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:var(--radius);padding:18px 22px;display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center;}
#kill-phase h2{font-family:'Cinzel',serif;font-size:1.05rem;color:var(--gold);}
#kill-phase p{color:var(--muted);font-size:0.88rem;line-height:1.5;}
.kill-gestures{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;}
.kill-gest-card{background:rgba(255,255,255,0.06);border:2px solid var(--border);border-radius:10px;padding:10px 14px;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:0.78rem;color:var(--muted);min-width:76px;}
.kill-gest-card.target{animation:pulse-target 1s ease-in-out infinite;}
@keyframes pulse-target{0%,100%{box-shadow:0 0 0 0 var(--wiz-glow,rgba(255,255,255,0.2))}50%{box-shadow:0 0 0 8px transparent}}
.kg-icon{font-size:1.7rem;}
.kg-name{font-family:'Cinzel',serif;font-size:0.66rem;letter-spacing:0.08em;}
.kill-bar-wrap{width:100%;height:9px;background:rgba(255,255,255,0.1);border-radius:5px;overflow:hidden;}
#kill-bar-fill{height:100%;border-radius:5px;width:0%;transition:width 0.05s;background:linear-gradient(90deg,var(--wiz-color,#999),#fff);}
.kill-hint{font-size:0.8rem;color:var(--gold);animation:pulse-text 1.5s ease-in-out infinite;}
@keyframes pulse-text{0%,100%{opacity:0.5}50%{opacity:1}}

/* RESULT OVERLAY */
#result-overlay{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,0.75);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity 0.3s;}
#result-overlay.show{opacity:1;pointer-events:all;}
.result-card{background:var(--panel);border:1px solid var(--border);border-radius:20px;padding:36px 44px;text-align:center;max-width:420px;width:100%;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:14px;}
.result-icon{font-size:4rem;}
.result-title{font-family:'Cinzel Decorative',cursive;font-size:1.9rem;}
.result-sub{color:var(--muted);font-size:0.9rem;line-height:1.6;}
.result-score-big{font-family:'Cinzel',serif;font-size:2.4rem;color:var(--gold);}
.result-score-label{font-size:0.75rem;color:var(--muted);letter-spacing:0.15em;text-transform:uppercase;}
.result-btns{display:flex;gap:10px;justify-content:center;margin-top:6px;}
.result-btn{font-family:'Cinzel',serif;font-size:0.88rem;font-weight:700;letter-spacing:0.08em;padding:11px 22px;border-radius:10px;border:none;cursor:pointer;transition:all 0.2s;}
.result-btn.primary{background:linear-gradient(135deg,var(--gold),#ff8a50);color:#0b0c1a;}
.result-btn.primary:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(245,200,66,0.4);}
.result-btn.secondary{background:rgba(255,255,255,0.06);color:var(--muted);border:1px solid var(--border);}
.result-btn.secondary:hover{color:var(--text);}
.result-card.win .result-title{color:var(--gold);}
.result-card.lose .result-title{color:#ef5350;}

/* SPARKS */
.spark{position:fixed;border-radius:50%;pointer-events:none;animation:spark-fly 0.9s ease-out forwards;}
@keyframes spark-fly{0%{transform:translate(0,0) scale(1);opacity:1}100%{transform:translate(var(--tx),var(--ty)) scale(0);opacity:0}}

@media(max-width:860px){
  #cam-panel{width:220px;}
  #answer-grid{grid-template-columns:1fr;max-width:380px;}
}
</style>
</head>
<body>

<canvas id="bg-canvas"></canvas>

<!-- MENU -->
<div id="menu-screen" class="screen">
  <span class="logo-icon">🧙</span>
  <div class="logo-title">Shadow Wizards</div>
  <div class="logo-sub">Gesture Spell Battle</div>

  <div class="menu-card">
    <div>
      <div class="menu-label">Number of Questions</div>
      <div class="diff-row" id="diff-row">
        <button class="diff-btn" data-q="5">5</button>
        <button class="diff-btn" data-q="10">10</button>
        <button class="diff-btn active" data-q="20">20</button>
        <button class="diff-btn" data-q="50">50</button>
        <button class="diff-btn" data-q="100">100</button>
        <button class="diff-btn" data-q="9999">∞</button>
      </div>
    </div>

    <div>
      <div class="menu-label">Game Mode</div>
      <div class="mode-row">
        <button class="mode-btn active" id="mode-normal" onclick="setMode('normal')">⚔️ Normal<br><small style="font-weight:400;color:var(--muted)">Wrong = Game Over</small></button>
        <button class="mode-btn" id="mode-tutorial" onclick="setMode('tutorial')">🎓 Tutorial<br><small style="font-weight:400;color:var(--muted)">Can't die — learn freely</small></button>
      </div>
    </div>

    <div class="toggle-row" id="skeleton-toggle" onclick="toggleSkeleton()">
      <span>👁 Show hand skeleton tracking</span>
      <div class="toggle-pill"></div>
    </div>

    <button class="start-btn" onclick="goToLoading()">⚡ Enter the Arena</button>
  </div>
</div>

<!-- LOADING -->
<div id="loading-screen" class="screen hidden">
  <span class="load-icon">🔮</span>
  <div class="load-title">Summoning the Arcane...</div>
  <p class="load-msg" id="load-msg">Initialising...</p>
  <div class="load-bar-wrap"><div class="load-bar" id="load-bar"></div></div>
</div>

<!-- GAME -->
<div id="game-screen" class="screen hidden">
  <!-- HUD -->
  <div id="hud">
    <div class="hud-left">
      <div class="hud-logo">Shadow Wizards</div>
      <div class="hud-mode" id="hud-mode-label">Normal</div>
    </div>
    <div class="hud-center">
      <div class="hud-qnum" id="hud-qnum">Q 1</div>
      <div class="hud-bar"><div class="hud-bar-fill" id="hud-bar-fill" style="width:0%"></div></div>
      <div class="hud-qnum" id="hud-qtotal">/ 20</div>
    </div>
    <div class="hud-right">
      <button class="cam-toggle-btn" onclick="toggleCamPanel()">📷 Camera</button>
      <div class="score-wrap">
        <div class="score-label">Score</div>
        <div class="score-val" id="score-val">0</div>
      </div>
    </div>
  </div>

  <div id="game-area">
    <!-- Arena (center) -->
    <div id="arena">
      <div class="tutorial-banner" id="tutorial-banner" style="display:none">🎓 Tutorial Mode — Wrong answers skip to next question instead of ending the game!</div>

      <div id="speech-bubble">
        <div class="wiz-name-label" id="wiz-name-label">The Dark Wizard</div>
        <div id="question-text">Loading...</div>
      </div>

      <div id="wizard-wrap">
        <div id="wizard-figure">🧙‍♂️</div>
        <div id="element-badge"><span id="elem-icon">🔥</span><span id="elem-name">Fire Wizard</span></div>
      </div>

      <!-- Answer buttons -->
      <div id="answer-grid">
        <button class="answer-btn a" id="btn-a" onclick="selectAnswer(0)">
          <div class="ans-gesture"><span>✌️</span><span class="ans-gesture-lbl">Peace</span></div>
          <div class="ans-text" id="ans-a">...</div>
          <div class="ans-letter">A</div>
        </button>
        <button class="answer-btn b" id="btn-b" onclick="selectAnswer(1)">
          <div class="ans-gesture"><span>👊</span><span class="ans-gesture-lbl">Fist</span></div>
          <div class="ans-text" id="ans-b">...</div>
          <div class="ans-letter">B</div>
        </button>
        <button class="answer-btn c" id="btn-c" onclick="selectAnswer(2)">
          <div class="ans-gesture"><span>👍</span><span class="ans-gesture-lbl">Thumb</span></div>
          <div class="ans-text" id="ans-c">...</div>
          <div class="ans-letter">C</div>
        </button>
        <button class="answer-btn d" id="btn-d" onclick="selectAnswer(3)">
          <div class="ans-gesture"><span>🖐️</span><span class="ans-gesture-lbl">Open</span></div>
          <div class="ans-text" id="ans-d">...</div>
          <div class="ans-letter">D</div>
        </button>
      </div>

      <!-- Kill phase -->
      <div id="kill-phase" style="display:none">
        <h2 id="kill-title">Cast the Killing Spell!</h2>
        <p id="kill-desc">Use the correct elemental gesture to defeat the wizard!</p>
        <div class="kill-gestures" id="kill-gestures-display"></div>
        <div style="width:100%">
          <div class="kill-bar-wrap"><div id="kill-bar-fill"></div></div>

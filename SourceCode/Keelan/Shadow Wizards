function setLoad(p,m){document.getElementById('load-bar').style.width=p+'%';document.getElementById('load-msg').textContent=m;}

let hands, mpCamera;
async function initMediaPipe(){
  setLoad(10,'Loading MediaPipe Hands...');
  const video=document.getElementById('input-video');
  const canvas=document.getElementById('output-canvas');
  const ctx=canvas.getContext('2d');
  hands=new Hands({locateFile:f=>`https://cdn.jsdelivr.net/npm/@mediapipe/hands/${f}`});
  hands.setOptions({maxNumHands:1,modelComplexity:1,minDetectionConfidence:0.75,minTrackingConfidence:0.6});
  setLoad(40,'Initialising hand tracker...');
  hands.onResults(res=>{
    canvas.width=video.videoWidth||320;
    canvas.height=video.videoHeight||240;
    ctx.save();ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.drawImage(res.image,0,0,canvas.width,canvas.height);
    if(res.multiHandLandmarks?.length){
      const lm=res.multiHandLandmarks[0];
      if(showSkeleton){
        drawConnectors(ctx,lm,HAND_CONNECTIONS,{color:'rgba(99,179,237,0.7)',lineWidth:2});
        drawLandmarks(ctx,lm,{color:'#63b3ed',fillColor:'rgba(99,179,237,0.3)',radius:3,lineWidth:1});
      }
      rawGesture=classify(lm);
    } else { rawGesture=null; }
    ctx.restore();
    updateGestureUI();
  });
  setLoad(70,'Starting camera...');
  try{
    const stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'}});
    video.srcObject=stream; await video.play();
    mpCamera=new Camera(video,{onFrame:async()=>{await hands.send({image:video});},width:320,height:240});
    await mpCamera.start();
  } catch(e){
    setLoad(0,'❌ Camera access denied. Please allow camera and reload the page.');
    return;
  }
  setLoad(100,'Ready!');
  setTimeout(()=>{showScreen('game-screen');initGame();},600);
}

/* ─── GESTURE CLASSIFIER ─── */
function classify(lm){
  const tips=[8,12,16,20],pips=[6,10,14,18];
  const ext=tips.map((t,i)=>lm[t].y<lm[pips[i]].y);
  const[idx,mid,rng,pnk]=ext;
  const thumbExt=lm[4].x<lm[3].x;
  if(thumbExt&&idx&&mid&&rng&&pnk) return 'open';
  if(!idx&&!mid&&!rng&&!pnk&&!thumbExt) return 'rock';
  if(thumbExt&&!idx&&!mid&&!rng&&!pnk) return 'thumb';
  if(!thumbExt&&idx&&mid&&!rng&&!pnk) return 'peace';
  if(!thumbExt&&idx&&!mid&&!rng&&pnk) return 'horns';
  if(thumbExt&&!idx&&!mid&&!rng&&pnk) return 'shaka';
  return null;
}

const GEST_LABELS={peace:'✌️ Peace (A)',rock:'👊 Fist (B)',thumb:'👍 Thumb (C)',open:'🖐️ Open (D)',horns:'🤘 Horns',shaka:'🤙 Shaka'};

function updateGestureUI(){
  document.getElementById('cam-gest-val').textContent=rawGesture?(GEST_LABELS[rawGesture]||rawGesture):'—';
  if(answerLocked||phase==='result') return;
  if(phase==='question') handleAnsLock();
  else if(phase==='kill') handleKillLock();
}

function handleAnsLock(){
  const ansIdx=ANS_MAP[rawGesture];
  if(ansIdx===undefined){resetLock();return;}
  if(lockGesture===rawGesture){
    const el=Date.now()-lockStart; lockProg=Math.min(el/LOCK_MS,1);
    document.getElementById('lock-bar-fill').style.width=(lockProg*100)+'%';
    if(lockProg>=1){answerLocked=true;selectAnswer(ansIdx);}
  } else {
    lockGesture=rawGesture;lockStart=Date.now();lockProg=0;
    document.getElementById('lock-bar-fill').style.width='0%';
  }
}

function handleKillLock(){
  const needed=currentElem.killGesture;
  const gestureMap={rock:'rock',fire:'horns',water:'shaka',air:'open'};
  const neededRaw=gestureMap[needed];
  if(rawGesture===neededRaw){
    if(lockGesture===rawGesture){
      const el=Date.now()-lockStart; lockProg=Math.min(el/LOCK_MS,1);
      document.getElementById('lock-bar-fill').style.width=(lockProg*100)+'%';
      document.getElementById('kill-bar-fill').style.width=(lockProg*100)+'%';
      if(lockProg>=1){answerLocked=true;killWizard();}
    } else { lockGesture=rawGesture;lockStart=Date.now();lockProg=0; }
  } else {
    resetLock();
    document.getElementById('kill-bar-fill').style.width='0%';
  }
}

function resetLock(){lockGesture=null;lockStart=null;lockProg=0;document.getElementById('lock-bar-fill').style.width='0%';}

/* ─── GAME INIT ─── */
function initGame(){
  score=0;qIdx=0;answerLocked=false;phase='question';
  const pool=[...QUESTION_BANK];
  shuffledQs=shuffle(pool).slice(0,Math.min(maxQ,pool.length));
  document.getElementById('score-val').textContent='0';
  document.getElementById('hud-qtotal').textContent=`/ ${shuffledQs.length}`;
  document.getElementById('hud-mode-label').textContent=gameMode==='tutorial'?'Tutorial':'Normal';
  document.getElementById('tutorial-banner').style.display=gameMode==='tutorial'?'block':'none';
  document.getElementById('result-overlay').classList.remove('show');
  spawnWizard(()=>loadQuestion());
}


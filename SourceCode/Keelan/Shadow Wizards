/* ─── BG PARTICLES ─── */
(function(){
  const c=document.getElementById('bg-canvas'),ctx=c.getContext('2d');
  const stars=[];
  function resize(){c.width=innerWidth;c.height=innerHeight;}
  resize(); window.addEventListener('resize',resize);
  for(let i=0;i<100;i++) stars.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.4+0.3,a:Math.random(),da:Math.random()*0.008+0.002,col:`hsl(${220+Math.random()*60},70%,${60+Math.random()*30}%)`});
  function draw(){ctx.clearRect(0,0,c.width,c.height);stars.forEach(s=>{s.a+=s.da;if(s.a>1||s.a<0)s.da*=-1;ctx.globalAlpha=s.a*0.7;ctx.fillStyle=s.col;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fill();});ctx.globalAlpha=1;requestAnimationFrame(draw);}
  draw();
})();

